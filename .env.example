# ==========================================
# SubOptima Environment Variables Example
# ==========================================

# Backend Configuration
PORT=5000
NODE_ENV=development

# Database URL
# For local SQLite development (zero configuration needed):
DATABASE_URL="file:./dev.db"

# For PostgreSQL (Docker or Cloud):
# DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/subscription_optimizer?schema=public"

# Authentication & JWT
JWT_SECRET="replace-with-a-secure-random-32-character-secret-in-production"
JWT_EXPIRES_IN="7d"

# CORS Allowed Origin
CORS_ORIGIN="http://localhost:5173"
