# ==========================================
# SubOptima - Git Ignore Rules
# ==========================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Production builds & compilations
dist/
build/
out/
coverage/
*.tsbuildinfo

# Environment variables & secrets (CRITICAL: never commit secrets)
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# Local SQLite databases & journals
*.db
*.db-journal
dev.db
dev.db-journal
backend/dev.db
backend/dev.db-journal

# Generated zip archives and downloads
*.zip
*.tar.gz
*.7z
backend/public/*.zip

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor directories & files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-project
*.sublime-workspace

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
