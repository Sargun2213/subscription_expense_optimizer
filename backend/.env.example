# Server configuration
PORT=5000
NODE_ENV=development

# Database configuration
# For local development with zero dependencies:
DATABASE_URL="file:./dev.db"
# For production PostgreSQL:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/subscription_optimizer?schema=public"

# Authentication & Security
JWT_SECRET="super-secret-jwt-key-replace-in-production-min-32-chars-long"
JWT_EXPIRES_IN="7d"

# CORS configuration
CORS_ORIGIN="http://localhost:5173"
